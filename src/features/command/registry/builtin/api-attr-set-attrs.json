{
    "id": "index.setAttributes",
    "name": "批量设置块属性",
    "description": "向思源后端发送原生 POST /api/attr/setBlockAttrs，更新指定块的自定义属性 (IAL)。",
    "dispatch": {
        "method": "api",
        "endpoint": "/api/attr/setBlockAttrs"
    },
    "params": [
        {
            "key": "id",
            "type": "blockid",
            "paramMode": "template",
            "default": "",
            "description": "目标块 ID"
        },
        {
            "key": "attrs",
            "type": "object",
            "paramMode": "template",
            "default": "",
            "description": "要更新的属性键值对 JSON，如 {\"custom-status\":\"done\"}"
        }
    ],
    "constraints": {
        "environment": "universal",
        "targetScope": "any",
        "comment": "思源原生 HTTP API，完全支持后台与定时调度"
    },
    "meta": {
        "contextNeed": "block",
        "category": "api",
        "source": "builtin"
    }
}
