        {
            "id": "editor.block.duplicate",
            "name": "复制当前块",
            "description": "将光标所在块复制一份，插入到其下方。依赖编辑器焦点，只能在当前可见块上触发，无法通过定时或远程调用任意块。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "duplicate"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "environment": "ui",
                "comment": "快捷键实现，无法指定任意块ID；如需定时复制请改用 api.block.insertBlock"
            },
            "meta": {
                "scope": "self",
                "category": "edit",
                "source": "builtin",
                "apiEquivalent": "api.block.insert",
                "appliesTo": ["paragraph", "heading", "list", "blockquote", "code", "table", "super"]
            },
            "seed": {
                "rowID": "20260526204558-zxrigm8",
                "label": "📑 复制当前块",
                "paramMapping": "",
                "uiEntries": ["palette"]
            }
        },
        {
            "id": "editor.block.insertBelow",
            "name": "在下方插入同级块",
            "description": "在当前块下方插入一个新的空块。依赖焦点。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "insertAfter"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "environment": "ui"
            },
            "meta": {
                "scope": "sibling",
                "category": "edit",
                "source": "builtin",
                "apiEquivalent": "api.block.insert",
                "appliesTo": ["paragraph", "heading", "list", "blockquote", "code", "table", "super"]
            }
        },
        {
            "id": "editor.block.copyRef",
            "name": "复制块引用",
            "description": "将当前块的引用格式复制到剪贴板（((block-id '内容'))）。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "copyBlockRef"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "environment": "ui"
            },
            "meta": {
                "scope": "self",
                "category": "clipboard",
                "source": "builtin",
                "appliesTo": ["paragraph", "heading", "list", "blockquote", "code", "table", "super"]
            }
        },
        {
            "id": "api.block.insert",
            "name": "API：插入块",
            "description": "通过后端 API 在指定块前/后插入指定内容的块。完全不依赖 UI 焦点，支持定时任务和远程触发。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/block/insertBlock"
            },
            "params": [
                {
                    "key": "dataType",
                    "label": "内容类型",
                    "type": "enum",
                    "values": [
                        "markdown",
                        "dom"
                    ],
                    "default": "markdown",
                    "required": true,
                    "paramMode": "static",
                    "description": "插入内容的格式"
                },
                {
                    "key": "data",
                    "label": "插入内容",
                    "type": "text",
                    "required": true,
                    "paramMode": "template",
                    "templateVars": [
                        "{{date}}",
                        "{{time}}",
                        "{{block_id}}",
                        "{{attr:*}}"
                    ],
                    "description": "插入的 Markdown 或 DOM 字符串，支持 {{变量}} 占位符"
                },
                {
                    "key": "previousID",
                    "label": "前驱块 ID",
                    "type": "blockid",
                    "required": false,
                    "paramMode": "template",
                    "default": "{{block_id}}",
                    "description": "留空时自动从触发上下文中注入当前块 ID"
                },
                {
                    "key": "nextID",
                    "label": "后继块 ID",
                    "type": "blockid",
                    "required": false,
                    "paramMode": "template",
                    "hidden": true,
                    "description": "指定插入到某块之前"
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "environment": "kernel"
            },
            "meta": {
                "scope": "sibling",
                "category": "edit",
                "source": "builtin"
            },
            "seed": {
                "rowID": "20260527120000-insert",
                "label": "⚡ API 插入块测试",
                "paramMapping": "{\"dataType\":\"markdown\",\"data\":\"[Auto Insert] Time: {{time}} | Date: {{date}}\"}",
                "uiEntries": ["palette"]
            }
        },
        {
            "id": "api.block.update",
            "name": "API：更新块内容",
            "description": "通过后端 API 更新指定块的内容。完全不依赖 UI，支持定时任务。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/block/updateBlock"
            },
            "params": [
                {
                    "key": "id",
                    "label": "目标块 ID",
                    "type": "blockid",
                    "required": true,
                    "paramMode": "template",
                    "default": "{{block_id}}",
                    "description": "目标块 ID，默认自动注入当前块 ID"
                },
                {
                    "key": "dataType",
                    "label": "内容类型",
                    "type": "enum",
                    "values": [
                        "markdown",
                        "dom"
                    ],
                    "default": "markdown",
                    "required": true,
                    "paramMode": "static"
                },
                {
                    "key": "data",
                    "label": "新内容",
                    "type": "text",
                    "required": true,
                    "paramMode": "template",
                    "templateVars": [
                        "{{date}}",
                        "{{time}}",
                        "{{attr:*}}"
                    ]
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "environment": "kernel"
            },
            "meta": {
                "scope": "self",
                "category": "edit",
                "source": "builtin"
            }
        },
        {
            "id": "api.attr.setAttrs",
            "name": "API：设置块属性",
            "description": "通过后端 API 为指定块写入或修改自定义属性键值对。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/attr/setBlockAttrs"
            },
            "params": [
                {
                    "key": "id",
                    "label": "目标块 ID",
                    "type": "blockid",
                    "required": true,
                    "paramMode": "template",
                    "default": "{{block_id}}"
                },
                {
                    "key": "attrs",
                    "label": "属性键值对",
                    "type": "object",
                    "required": true,
                    "paramMode": "static",
                    "description": "JSON 对象，如 {\"custom-status\": \"done\", \"custom-priority\": \"high\"}"
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "environment": "kernel"
            },
            "meta": {
                "scope": "self",
                "category": "attribute",
                "source": "builtin"
            }
        },
        {
            "id": "plugin-index.effect.fireworks",
            "name": "烟花",
