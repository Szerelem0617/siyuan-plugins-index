{
    "$schema": "./commands.schema.json",
    "_comment": "Command Registry — Source of Truth. Do NOT store user configs here. Add third-party commands via registerCommand() API.",
    "version": "1.0.0",
    "commands": [
        {
            "id": "general.graphView",
            "name": "全局关系图",
            "description": "呼出全局块关系图面板。",
            "dispatch": {
                "method": "global",
                "target": "graphView"
            },
            "params": [],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": true,
                "schedulable": false,
                "comment": "依赖思源 UI 状态，无法定时触发"
            },
            "meta": {
                "scope": "global",
                "category": "navigation",
                "source": "builtin"
            }
        },
        {
            "id": "general.inbox",
            "name": "打开收集箱",
            "description": "打开每日收集箱。",
            "dispatch": {
                "method": "global",
                "target": "inbox"
            },
            "params": [],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": true,
                "schedulable": false
            },
            "meta": {
                "scope": "global",
                "category": "navigation",
                "source": "builtin"
            }
        },
        {
            "id": "general.splitLR",
            "name": "在右侧分屏打开",
            "description": "将当前文档在右侧新面板打开。",
            "dispatch": {
                "method": "global",
                "target": "splitLR"
            },
            "params": [],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": true,
                "schedulable": false
            },
            "meta": {
                "scope": "global",
                "category": "view",
                "source": "builtin"
            }
        },
        {
            "id": "editor.general.duplicate",
            "name": "复制当前块",
            "description": "将光标所在块复制一份，插入到其下方。依赖编辑器焦点，只能在当前可见块上触发，无法通过定时或远程调用任意块。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "duplicate"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "uiOnly": true,
                "schedulable": false,
                "comment": "快捷键实现，无法指定任意块ID；如需定时复制请改用 api.block.insertBlock"
            },
            "meta": {
                "scope": "self",
                "category": "edit",
                "source": "builtin",
                "apiEquivalent": "api.block.insertBlock"
            }
        },
        {
            "id": "editor.general.insertAfter",
            "name": "在下方插入同级块",
            "description": "在当前块下方插入一个新的空块。依赖焦点。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "insertAfter"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "uiOnly": true,
                "schedulable": false
            },
            "meta": {
                "scope": "sibling",
                "category": "edit",
                "source": "builtin",
                "apiEquivalent": "api.block.insertBlock"
            }
        },
        {
            "id": "editor.general.copyBlockRef",
            "name": "复制块引用",
            "description": "将当前块的引用格式复制到剪贴板（((block-id '内容'))）。",
            "dispatch": {
                "method": "keyboard",
                "keymapPath": [
                    "editor",
                    "general",
                    "copyBlockRef"
                ]
            },
            "params": [],
            "constraints": {
                "requiresFocus": true,
                "uiOnly": true,
                "schedulable": false
            },
            "meta": {
                "scope": "self",
                "category": "clipboard",
                "source": "builtin"
            }
        },
        {
            "id": "api.block.insertBlock",
            "name": "API：插入块",
            "description": "通过后端 API 在指定块前/后插入指定内容的块。完全不依赖 UI 焦点，支持定时任务和远程触发。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/block/insertBlock"
            },
            "params": [
                {
                    "key": "dataType",
                    "label": "内容类型",
                    "type": "enum",
                    "values": [
                        "markdown",
                        "dom"
                    ],
                    "default": "markdown",
                    "required": true,
                    "paramMode": "static",
                    "description": "插入内容的格式"
                },
                {
                    "key": "data",
                    "label": "插入内容",
                    "type": "text",
                    "required": true,
                    "paramMode": "template",
                    "templateVars": [
                        "{{date}}",
                        "{{time}}",
                        "{{block_id}}",
                        "{{attr:*}}"
                    ],
                    "description": "插入的 Markdown 或 DOM 字符串，支持 {{变量}} 占位符"
                },
                {
                    "key": "previousID",
                    "label": "前驱块 ID",
                    "type": "blockid",
                    "required": false,
                    "paramMode": "template",
                    "default": "{{block_id}}",
                    "description": "留空时自动从触发上下文中注入当前块 ID"
                },
                {
                    "key": "nextID",
                    "label": "后继块 ID",
                    "type": "blockid",
                    "required": false,
                    "paramMode": "template",
                    "hidden": true,
                    "description": "指定插入到某块之前"
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": false,
                "schedulable": true
            },
            "meta": {
                "scope": "sibling",
                "category": "edit",
                "source": "builtin"
            }
        },
        {
            "id": "api.block.updateBlock",
            "name": "API：更新块内容",
            "description": "通过后端 API 更新指定块的内容。完全不依赖 UI，支持定时任务。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/block/updateBlock"
            },
            "params": [
                {
                    "key": "id",
                    "label": "目标块 ID",
                    "type": "blockid",
                    "required": true,
                    "paramMode": "template",
                    "default": "{{block_id}}",
                    "description": "目标块 ID，默认自动注入当前块 ID"
                },
                {
                    "key": "dataType",
                    "label": "内容类型",
                    "type": "enum",
                    "values": [
                        "markdown",
                        "dom"
                    ],
                    "default": "markdown",
                    "required": true,
                    "paramMode": "static"
                },
                {
                    "key": "data",
                    "label": "新内容",
                    "type": "text",
                    "required": true,
                    "paramMode": "template",
                    "templateVars": [
                        "{{date}}",
                        "{{time}}",
                        "{{attr:*}}"
                    ]
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": false,
                "schedulable": true
            },
            "meta": {
                "scope": "self",
                "category": "edit",
                "source": "builtin"
            }
        },
        {
            "id": "api.attr.setBlockAttrs",
            "name": "API：设置块属性",
            "description": "通过后端 API 为指定块写入或修改自定义属性键值对。",
            "dispatch": {
                "method": "api",
                "endpoint": "/api/attr/setBlockAttrs"
            },
            "params": [
                {
                    "key": "id",
                    "label": "目标块 ID",
                    "type": "blockid",
                    "required": true,
                    "paramMode": "template",
                    "default": "{{block_id}}"
                },
                {
                    "key": "attrs",
                    "label": "属性键值对",
                    "type": "object",
                    "required": true,
                    "paramMode": "static",
                    "description": "JSON 对象，如 {\"custom-status\": \"done\", \"custom-priority\": \"high\"}"
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "uiOnly": false,
                "schedulable": true
            },
            "meta": {
                "scope": "self",
                "category": "attribute",
                "source": "builtin"
            }
        }
    ],
    "paramModes": {
        "_doc": "参数获取方式的标准说明文档",
        "static": "静态参：在 Command Param 列中写死，执行时直接使用",
        "template": "模板参：字符串中含有 {{占位符}}，Dispatcher 在执行前实时计算并替换",
        "interactive": "交互参：执行前弹出 UI 让用户输入，由 UI Generator 动态生成表单"
    },
    "templateVars": {
        "_doc": "全局有效的模板变量，可在所有 template 类型参数中使用",
        "{{date}}": "当前日期，格式 YYYY-MM-DD",
        "{{time}}": "当前时间，格式 HH:mm:ss",
        "{{block_id}}": "触发命令的块 ID",
        "{{parent_id}}": "触发块的父块 ID（API 查询）",
        "{{root_id}}": "所在文档的根块 ID",
        "{{notebook_id}}": "所在笔记本 ID",
        "{{attr:KEY}}": "触发块的指定属性值，如 {{attr:custom-status}}"
    }
}