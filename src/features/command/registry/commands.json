        },
        {
            "id": "siyuan.ui.toast",
            "name": "消息提示 (showMessage)",
            "description": "在思源右上角弹出气泡提示。支持自定义消息内容；无传参时显示默认内容。",
            "dispatch": {
                "method": "custom"
            },
            "params": [
                {
                    "key": "message",
                    "label": "消息内容",
                    "type": "text",
                    "required": false,
                    "paramMode": "template",
                    "default": "看到这条消息会有好运～",
                    "templateVars": ["{{date}}", "{{time}}", "{{block_id}}", "{{attr:KEY}}"]
                },
                {
                    "key": "timeout",
                    "label": "显示时长 (毫秒)",
                    "type": "number",
                    "required": false,
                    "paramMode": "static",
                    "default": 6000,
                    "description": "提示悬浮时长（毫秒）。默认6000；0表示显示手动关闭按钮；-1表示永不自动淡出。"
                },
                {
                    "key": "type",
                    "label": "提示类型",
                    "type": "enum",
                    "values": ["info", "error"],
                    "required": false,
                    "paramMode": "static",
                    "default": "info",
                    "hidden": true,
                    "description": "info（普通信息）或 error（红底错误）。"
                },
                {
                    "key": "messageId",
                    "label": "消息 ID",
                    "type": "text",
                    "required": false,
                    "paramMode": "static",
                    "hidden": true,
                    "description": "指定唯一 ID。重复触发该 ID 时，气泡会在原地更新内容而非不断堆叠。"
                }
            ],
            "constraints": {
                "requiresFocus": false,
                "environment": "universal"
            },
            "meta": {
                "scope": "self",
                "category": "custom",
                "source": "plugin",
                "plugin": "index"
            },
            "seed": {
                "rowID": "20260713120000-showmessage",
                "label": "💬 消息提示",
                "paramMapping": "",
                "uiEntries": ["inline", "palette"]
            }
        },
        {
            "id": "plugin-index.command.turnIntoTask",
            "name": "转换为任务",
            "description": "将选中的普通段落、标题或整个列表转换为任务列表。",
            "dispatch": {
                "method": "custom"
            },
            "params": [],
            "constraints": {
                "requiresFocus": false,
