        {
            "id": "plugin-index.supertag.addTag",
            "name": "添加超级标签",
            "description": "为指定的块添加一个超级标签（更新 custom-supertags 属性并向 DOM 挂载内联 Tag 标头）。支持界面交互，也可供后台纯 API 调用。",
            "dispatch": {
                "method": "custom"
            },
            "params": [
                {
                    "key": "id",
                    "type": "blockid",
                    "paramMode": "template",
                    "default": "",
                    "description": "目标块 ID。不填时自动绑定当前上下文块。"
                },
                {
                    "key": "tag",
                    "type": "string",
                    "paramMode": "template",
                    "default": "",
                    "description": "超级标签名称（无需带 # 号，例如 project/task）。"
                }
            ],
            "outputs": [
                {
                    "key": "supertags",
                    "type": "string",
                    "default": "var.supertags",
                    "description": "更新后的完整超级标签数组 JSON 字符串"
                }
            ],
            "constraints": {
                "environment": "universal",
                "targetScope": "any",
                "comment": "支持前台交互注入与后台无界面静默调度"
            },
            "meta": {
                "contextNeed": "block",
                "category": "edit",
                "source": "builtin"
            },
            "seed": {
                "rowID": "20260526204558-addtag9",
                "label": "🏷️ 添加超级标签",
                "paramMapping": "{\"tag\":\"{{prompt:请输入标签名}}\"}"
            }
        },
        {
            "id": "plugin-index.command.insertBlockBelow",
            "name": "在下方插入块",
            "description": "在指定的目标块/页面下方插入新块或子页面，支持短码 (p/h/c/b/l/t/tb) 与模板占位符。",
            "dispatch": {
                "method": "custom"
            },
            "params": [
                {
                    "key": "id",
                    "type": "blockid",
                    "paramMode": "template",
                    "default": "",
                    "description": "目标块或页面 ID。不填自动取当前触发块。"
                },
                {
                    "key": "data",
                    "type": "string",
                    "paramMode": "template",
                    "default": "",
                    "description": "新块的内容或子页面标题 (支持 {{prompt}} / {{time}} 占位符)"
                },
                {
                    "key": "insertType",
                    "type": "enum",
                    "values": ["p", "h", "c", "b", "l", "t", "tb"],
                    "paramMode": "template",
                    "default": "p",
                    "description": "原生块类型短码 (p:段落, h:标题, c:代码块, b:引述, l:列表, t:表格, tb:分割线)"
                },
                {
                    "key": "pageInsertMode",
                    "type": "enum",
                    "values": ["bottom", "top", "child_doc"],
                    "paramMode": "template",
                    "default": "bottom",
                    "description": "页面专有插入策略 (bottom:页面尾部, top:页面顶部, child_doc:创建子页面)"
                }
            ],
            "outputs": [
                {
                    "key": "createdblock",
                    "type": "string",
                    "default": "var.createdblock",
                    "description": "成功插入的新块或新子页面的物理 Block ID"
                }
            ],
            "constraints": {
                "environment": "universal",
                "targetScope": "any",
                "comment": "双端多态通用：支持在任意块正下方插入或在页面下建子页面"
            },
            "meta": {
                "contextNeed": "block",
                "category": "edit",
                "source": "builtin"
            },
            "seed": {
                "rowID": "20260526204558-insblk1",
                "label": "➕ 在下方插入块",
                "paramMapping": "{}"
            }
        },
