            },
            "meta": {
                "scope": "self",
                "category": "edit",
                "source": "plugin",
                "plugin": "index",
                "appliesTo": ["paragraph", "heading", "list"]
            },
            "seed": {
                "rowID": "20260714160000-turnintotask",
                "label": "☑ 转换为任务",
                "paramMapping": "",
                "uiEntries": ["palette"]
            }
        }
    ],
    "paramModes": {
        "_doc": "参数获取方式的标准说明文档",
        "static": "静态参：在 Command Param 列中写死，执行时直接使用",
        "template": "模板参：字符串中含有 {{占位符}}，Dispatcher 在执行前实时计算并替换",
        "interactive": "交互参：执行前弹出 UI 让用户输入，由 UI Generator 动态生成表单"
    },
    "templateVars": {
        "_doc": "全局有效的模板变量，可在所有 template 类型参数中使用",
        "{{date}}": "当前日期，格式 YYYY-MM-DD",
        "{{time}}": "当前时间，格式 HH:mm:ss",
        "{{block_id}}": "触发命令的块 ID",
        "{{parent_id}}": "触发块的父块 ID（API 查询）",
        "{{root_id}}": "所在文档的根块 ID",
        "{{notebook_id}}": "所在笔记本 ID",
        "{{attr:KEY}}": "触发块的指定属性值，如 {{attr:custom-status}}"
    }
}