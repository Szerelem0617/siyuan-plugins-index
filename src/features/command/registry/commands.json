        {
            "id": "plugin-index.supertag.addTag",
            "name": "添加超级标签",
            "description": "为指定的块添加一个超级标签（更新 custom-supertags 属性并向 DOM 挂载内联 Tag 标头）。支持界面交互，也可供后台纯 API 调用。",
            "dispatch": {
                "method": "custom"
            },
            "params": [
                {
                    "key": "id",
                    "type": "blockid",
                    "paramMode": "template",
                    "default": "",
                    "description": "目标块 ID。不填时自动绑定当前上下文块。"
                },
                {
                    "key": "tag",
                    "type": "string",
                    "paramMode": "template",
                    "default": "",
                    "description": "超级标签名称（无需带 # 号，例如 project/task）。"
                }
            ],
            "outputs": [
                {
                    "key": "supertags",
                    "type": "string",
                    "description": "更新后的完整超级标签数组 JSON 字符串"
                }
            ],
            "constraints": {
                "environment": "universal",
                "targetScope": "any",
                "comment": "支持前台交互注入与后台无界面静默调度"
            },
            "meta": {
                "contextNeed": "block",
                "category": "edit",
                "source": "builtin"
